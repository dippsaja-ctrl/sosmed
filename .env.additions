# ===== Tambahkan ke file .env project Laravel Anda =====
APP_URL=https://GANTI-DENGAN-URL-PUBLIK-ANDA     # wajib publik (lihat README bagian 4)
APP_LOCALE=id
QUEUE_CONNECTION=database

GRAPH_VERSION=v21.0

# Meta (Instagram + Facebook)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY=SELF_ONLY          # ganti ke PUBLIC_TO_EVERYONE hanya setelah audit TikTok disetujui

# Google / YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
